{
  "manifest_version": 3,
  "name": "Fantasy Intel Yahoo League Sync",
  "version": "3.2.0",
  "description": "Sync Battle of the Kings Yahoo players, rosters, weekly scoring, matchups and waivers into Fantasy Intel.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://football.fantasysports.yahoo.com/*",
    "https://bbodmhffnqebhfksjier.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/*"
      ],
      "js": [
        "league-sync.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fantasy Intel Yahoo Sync",
    "default_popup": "popup.html"
  }
}
